#!/bin/sh
set -e

branch=$(git branch --show-current)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

timestamp=$(date +%s)
report="src/docs/quality/codegrade-${timestamp}.json"

mkdir -p src/docs/quality

local_repository="${MAVEN_LOCAL_REPOSITORY:-$HOME/.m2/repository}"
cli_jar=$(find "$local_repository/com/github/codemonstur/codegrade-cli" \
  -name 'codegrade-cli-*.jar' \
  ! -name '*-sources.jar' \
  ! -name '*-javadoc.jar' 2>/dev/null | sort -V | tail -n 1)

if [ -z "$cli_jar" ]; then
  echo "codegrade-cli jar not found in $local_repository; skipping quality report" >&2
  exit 0
fi

java -jar "$cli_jar" . --format JSON --output "$report"

git add "$report"
